{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/guard-frozen-tests.ps1"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "PowerShell(powershell -File scripts/*)",
      "PowerShell(.\\scripts\\*)"
    ]
  }
}
